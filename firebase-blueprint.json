{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with academic settings and details",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "institution": { "type": "string" },
        "grade": { "type": "string" },
        "board": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string" },
        "learningGoal": { "type": "string" },
        "learningStyle": { "type": "string" },
        "credits": { "type": "number" },
        "planType": { "type": "string" },
        "claimedOffers": { "type": "array" }
      },
      "required": ["credits"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User specific push or pull notifications",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" },
        "read": { "type": "boolean" },
        "targetUserId": { "type": "string" }
      },
      "required": ["title", "body", "timestamp", "read"]
    },
    "GlobalNotification": {
      "title": "GlobalNotification",
      "description": "Broadcast notifications for all users",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["title", "body", "timestamp"]
    },
    "Streak": {
      "title": "StreakData",
      "description": "Duolingo-style daily learning streak records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "currentStreak": { "type": "number" },
        "highestStreak": { "type": "number" },
        "lastActivityDate": { "type": "string" },
        "streakHistory": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "currentStreak", "highestStreak", "lastActivityDate", "streakHistory", "updatedAt"]
    },
    "History": {
      "title": "HistoryItem",
      "description": "User specific course learning activities, quizzes, summary history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "timestamp": { "type": "number" },
        "content": { "type": "object" },
        "formData": { "type": "object" },
        "score": { "type": "number" }
      },
      "required": ["id", "type", "title", "timestamp"]
    },
    "DeviceSession": {
      "title": "DeviceSession",
      "description": "Active user device session and login metadata",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "deviceType": { "type": "string" },
        "os": { "type": "string" },
        "browser": { "type": "string" },
        "timezone": { "type": "string" },
        "loginTime": { "type": "number" },
        "lastActive": { "type": "number" },
        "status": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["deviceId", "deviceName", "loginTime", "lastActive", "status"]
    },
    "SharedContent": {
      "title": "SharedContent",
      "description": "Public shared quiz, summary, notes, homework or tutor transcripts",
      "type": "object",
      "properties": {
        "shareId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "object" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "number" },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "sharesCount": { "type": "number" },
        "lastViewedAt": { "type": "number" }
      },
      "required": ["shareId", "type", "title", "content", "ownerUid", "createdAt", "views", "likes", "isPublic"]
    },
    "QuizLeaderboard": {
      "title": "QuizLeaderboard",
      "description": "User overall quiz points, high score, and rank summaries",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalScore": { "type": "number" },
        "quizzesCompleted": { "type": "number" },
        "highestScore": { "type": "number" },
        "lastActive": { "type": "number" }
      },
      "required": ["uid", "displayName", "totalScore", "quizzesCompleted", "highestScore", "lastActive"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Notification created by admin, possibly scheduled",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" },
        "scheduledTime": { "type": "number" },
        "status": { "type": "string" },
        "targetType": { "type": "string" },
        "targetValue": { "type": "array" }
      },
      "required": ["title", "body", "timestamp", "status", "targetType"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Audit log for sent notifications",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" },
        "senderId": { "type": "string" },
        "targetType": { "type": "string" },
        "targetValue": { "type": "array" },
        "recipientCount": { "type": "number" },
        "successCount": { "type": "number" },
        "failureCount": { "type": "number" },
        "status": { "type": "string" },
        "errors": { "type": "array" },
        "retryCount": { "type": "number" }
      },
      "required": ["title", "body", "timestamp", "senderId", "targetType", "recipientCount", "successCount", "failureCount", "status"]
    },
    "Group": {
      "title": "StudyGroup",
      "description": "WhatsApp-like study group for real-time collaboration and chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "members": { "type": "object" },
        "memberCount": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "inviteCode": { "type": "string" }
      },
      "required": ["id", "name", "subject", "createdBy", "createdAt", "memberCount", "isPublic"]
    },
    "GroupMessage": {
      "title": "GroupMessage",
      "description": "Messages sent within a study group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["id", "groupId", "senderId", "senderName", "text", "timestamp", "type"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "1-on-1 friendship link or pending request between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "users": { "type": "array" },
        "status": { "type": "string" },
        "requestedBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "userDetails": { "type": "object" }
      },
      "required": ["id", "users", "status", "requestedBy", "createdAt"]
    },
    "DirectChat": {
      "title": "DirectChat",
      "description": "1-on-1 private chat session between two friends",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "object" },
        "unreadCount": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "participants", "createdAt", "updatedAt"]
    },
    "UserTimer": {
      "title": "UserTimer",
      "description": "Real-time cross-device timer and focus mode synchronization state",
      "type": "object",
      "properties": {
        "timerState": { "type": "string" },
        "timeLeftMs": { "type": "number" },
        "initialTimeMs": { "type": "number" },
        "expectedEndTime": { "type": "number" },
        "isFocusModeActive": { "type": "boolean" },
        "selectedApps": { "type": "array" },
        "inputH": { "type": "string" },
        "inputM": { "type": "string" },
        "inputS": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["timerState", "timeLeftMs", "initialTimeMs", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Completed or recorded study sessions for user analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "duration": { "type": "number" },
        "completed": { "type": "boolean" },
        "focusMode": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["date", "duration", "completed"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private message sent directly between two friends",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "senderName", "text", "timestamp", "type"]
    },
    "DirectCall": {
      "title": "DirectCall",
      "description": "1-on-1 audio and video calling session between friends",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "startedAt": { "type": "number" }
      },
      "required": ["id", "callerId", "callerName", "receiverId", "receiverName", "type", "status", "startedAt"]
    },
    "GroupCall": {
      "title": "GroupCall",
      "description": "Group study room audio and video calls",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "hostUid": { "type": "string" },
        "hostName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "startedAt": { "type": "number" },
        "participants": { "type": "object" }
      },
      "required": ["id", "groupId", "groupName", "hostUid", "hostName", "type", "status", "startedAt"]
    },
    "LinkedIdentity": {
      "title": "LinkedIdentity",
      "description": "Provider identity linked to an SJ Tutor AI user account",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "provider": { "type": "string" },
        "providerUserId": { "type": "string" },
        "providerEmail": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "provider", "providerUserId", "verified", "createdAt"]
    },
    "SjTutorId": {
      "title": "SjTutorId",
      "description": "Unique native SJ Tutor AI identifier and security credentials",
      "type": "object",
      "properties": {
        "sjTutorId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "twoStepEnabled": { "type": "boolean" },
        "twoStepSecret": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["sjTutorId", "userId", "passwordHash", "twoStepEnabled", "createdAt"]
    }
  },
  "firestore": {
    "/linked_identities/{identityId}": {
      "schema": "LinkedIdentity",
      "description": "Linked authentication identities (Google, Apple, Yahoo, GitHub, Email, SJ Tutor AI ID)"
    },
    "/sj_tutor_ids/{sjtutorId}": {
      "schema": "SjTutorId",
      "description": "Native SJ Tutor AI identifier credentials and 2-step verification data"
    },
    "/calls/{callId}": {
      "schema": "DirectCall",
      "description": "1-on-1 direct audio and video call signaling and records"
    },
    "/group_calls/{callId}": {
      "schema": "GroupCall",
      "description": "Group study live audio/video calls"
    },
    "/friendships/{friendshipId}": {

      "schema": "Friendship",
      "description": "Friendship requests and active connections"
    },
    "/direct_chats/{chatId}": {
      "schema": "DirectChat",
      "description": "1-on-1 private direct chats between friends"
    },
    "/direct_chats/{chatId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "1-on-1 private messages between friends"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Study group records"
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": "GroupMessage",
      "description": "Messages sent inside a group"
    },
    "/notifications/{notificationId}": {
      "schema": "AdminNotification",
      "description": "Admin scheduled or broadcast notifications"
    },
    "/notification_logs/{logId}": {
      "schema": "NotificationLog",
      "description": "Audit log history of sent notifications"
    },
    "/sharedContent/{shareId}": {
      "schema": "SharedContent",
      "description": "Public viewing records of shared materials"
    },
    "/quiz_leaderboard/{userId}": {
      "schema": "QuizLeaderboard",
      "description": "Leaderboard statistics for each user"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores individual user profile and setting details"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User specific notification records"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "History",
      "description": "User specific generated course history, quizzes, and homework items"
    },
    "/users/{userId}/timer/{timerId}": {
      "schema": "UserTimer",
      "description": "Real-time timer synchronization across all devices for the user"
    },
    "/users/{userId}/study_sessions/{sessionId}": {
      "schema": "StudySession",
      "description": "User recorded study sessions"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "DeviceSession",
      "description": "User active logged-in device sessions and metadata"
    },
    "/global_notifications/{notificationId}": {
      "schema": "GlobalNotification",
      "description": "System-wide broadcast alerts"
    },
    "/streaks/{userId}": {
      "schema": "Streak",
      "description": "Stores user daily sequence progress and stats"
    }
  }
}
