{
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "https://i.ibb.co/KpxwNSMS/SJ-Tutor-AI-Logo.jpg",
      "permanent": false
    },
    {
      "source": "/favicon.png",
      "destination": "https://i.ibb.co/KpxwNSMS/SJ-Tutor-AI-Logo.jpg",
      "permanent": false
    },
    {
      "source": "/logo.png",
      "destination": "https://i.ibb.co/KpxwNSMS/SJ-Tutor-AI-Logo.jpg",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!SJ-Tutor-AI-Logo\\.jpg|logo\\.jpg|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/SJ-Tutor-AI-Logo.jpg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
