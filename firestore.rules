rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'sjtutorai@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    // Users collection & subcollections
    match /users/{userId} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin() || !isSignedIn()) && isValidId(userId);

      match /notes/{noteId} {
        allow read, write: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
      }

      match /notifications/{notificationId} {
        allow read, delete: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
        allow create, update: if (isSignedIn() || isAdmin() || !isSignedIn()) && isValidId(userId);
      }

      match /history/{historyId} {
        allow read, write: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
      }

      match /timer/{timerId} {
        allow read, write: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
      }

      match /study_sessions/{sessionId} {
        allow read, write: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if (isOwner(userId) || !isSignedIn()) && isValidId(userId);
      }

      match /{subcollection=**} {
        allow read, write: if (isOwner(userId) || isAdmin() || !isSignedIn());
      }
    }

    // Top-level notifications (Admin scheduled or broadcast)
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(notificationId);
    }

    // Notification Logs
    match /notification_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Global notifications (Broadcast announcements)
    match /global_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Streaks collection (Public leaderboard read, user streak updates)
    match /streaks/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && (isOwner(userId) || !isSignedIn());
      allow delete: if isAdmin();
    }

    // Quiz leaderboard collection (Public leaderboard read, user score updates)
    match /quiz_leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && (isOwner(userId) || !isSignedIn());
      allow delete: if isAdmin();
    }

    // Study Groups collection and nested subcollections (Messages, Polls, etc.)
    match /groups/{groupId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Direct calls collection (signaling and active status)
    match /calls/{callId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Group study calls collection and signaling subcollections
    match /group_calls/{callId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Friendships collection (Friend requests and connections)
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }

    // Direct chats collection (1-on-1 chats and messages)
    match /direct_chats/{chatId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Shared content collection (Public shared quizzes, summaries, study aids)
    match /sharedContent/{shareId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() && (
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) || 
        ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Linked authentication identities
    match /linked_identities/{identityId} {
      allow read: if true;
      allow write: if true;
    }

    // Native SJ Tutor AI ID credentials
    match /sj_tutor_ids/{sjtutorId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
