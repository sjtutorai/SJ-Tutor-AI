rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'sjtutorai@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    // Notes subcollection
    match /users/{userId}/notes/{noteId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Notifications subcollection (userNotifications)
    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if isOwner(userId) && isValidId(userId);
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(notificationId);
    }

    // Top-level notifications (Admin scheduled or broadcast)
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(notificationId);
    }

    // Notification Logs
    match /notification_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(logId);
    }

    // History subcollection
    match /users/{userId}/history/{historyId} {
      allow read: if isOwner(userId) && isValidId(userId);
      allow write: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
    }

    // Real-time Timer subcollection for cross-device sync
    match /users/{userId}/timer/{timerId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Study Sessions subcollection
    match /users/{userId}/study_sessions/{sessionId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Global notifications
    match /global_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if false; // System only
    }

    // Streaks collection (allow reading list/documents for Leaderboard, owner writes only)
    match /streaks/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false; // Streak data shouldn't be deleted by client
    }

    // Quiz leaderboard collection (allow reading list/documents for Leaderboard, owner writes only)
    match /quiz_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Direct calls collection (signaling and active status)
    match /calls/{callId} {
      allow read, write: if isSignedIn() || true;
    }

    // Group study calls collection
    match /group_calls/{callId} {
      allow read, write: if true;
    }

    // Friendships collection
    match /friendships/{friendshipId} {
      allow read, write: if isSignedIn();
    }

    // Direct chats collection
    match /direct_chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Shared content collection - zero-trust dynamic permissions
    match /sharedContent/{shareId} {
      allow read: if resource == null || 
                     (!('isPublic' in resource.data) || resource.data.isPublic == true) || 
                     (isSignedIn() && 
                       (('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) || 
                        ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid)));
                        
      allow create: if isValidId(shareId) && (
        (isSignedIn() && 
          (('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) || 
           ('ownerUid' in request.resource.data && request.resource.data.ownerUid == request.auth.uid))) ||
        (!isSignedIn() || ('ownerId' in request.resource.data && request.resource.data.ownerId == "guest") || 
         ('ownerUid' in request.resource.data && request.resource.data.ownerUid == "guest"))
      );
      
      allow delete: if isSignedIn() && isValidId(shareId) && 
                      (('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) || 
                       ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid));
                       
      allow update: if isValidId(shareId) && (
        (isSignedIn() && 
          (('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) || 
           ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid))) ||
        ((!('isPublic' in resource.data) || resource.data.isPublic == true) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes', 'sharesCount', 'lastViewedAt']))
      );
    }
  }
}
